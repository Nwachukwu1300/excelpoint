# Copy to .env and fill in. DEBUG defaults to off; set it to True for local dev.
DEBUG=True
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=excelpoint
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

OPENAI_API_KEY=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/users/google/callback/

# local or s3
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# Optional LLM judge for answer quality (adds one LLM call per answer)
EVAL_LLM_JUDGE=False
LOG_LEVEL=INFO

# Chat model (any chat model your key can use)
OPENAI_MODEL=gpt-5.4-mini

# Max chat/reasoning questions per user (each costs LLM calls), e.g. 60/hour or 200/day
LLM_RATE_LIMIT=60/hour

# --- Production with docker compose (see README "Deploying") ---
# Your domain; Caddy gets its HTTPS certificate. Also add it to ALLOWED_HOSTS and use DEBUG=False.
DOMAIN=
# docker-compose.yml sets DB_HOST, DB_PORT, REDIS_URL, CACHE_URL and NUM_PROXIES for you.
# Once HTTPS works, tell browsers to always use it (e.g. 31536000 = one year)
SECURE_HSTS_SECONDS=0

# Email for password reset (any SMTP service). Leave EMAIL_HOST empty to print emails to the console.
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_HOST_USER=you@gmail.com, EMAIL_HOST_PASSWORD=<16-character app password>
# Resend (needs a verified domain): EMAIL_HOST=smtp.resend.com, EMAIL_PORT=587, EMAIL_HOST_USER=resend, EMAIL_HOST_PASSWORD=<API key>, DEFAULT_FROM_EMAIL=ExcelPoint <noreply@yourdomain>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
